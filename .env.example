# -------------------------------------------------------------
# TiDB Cloud & Vercel Environment Variables Configuration
# -------------------------------------------------------------
# Add these variables to your Vercel Project Dashboard:
# (Vercel Project -> Settings -> Environment Variables)

# TiDB Cloud Gateway Host (from your TiDB cluster)
DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com

# TiDB Cloud Port (TiDB standard default is 4000)
DB_PORT=4000

# TiDB Database Name
DB_NAME=barangay_health_db

# TiDB Cloud Username
DB_USER=3C8ypBiyvcsmXj6.root

# TiDB Cloud Password (generated from the "Generate Password" button)
DB_PASSWORD=YOUR_GENERATED_PASSWORD_HERE
