# -------------------------------------------------------------
# TiDB Cloud & Vercel Environment Variables Configuration
# -------------------------------------------------------------
# Copy these values into your Vercel Project Dashboard:
# Settings -> Environment Variables

# TiDB Cloud Host (from TiDB Cloud Cluster Overview / Connect Modal)
# Example: gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com

# TiDB Cloud Port (TiDB standard default is 4000)
DB_PORT=4000

# TiDB Database Name (default is typically "barangay_health_db" or "test")
DB_NAME=barangay_health_db

# TiDB Cloud Username (e.g. your_prefix.root)
DB_USER=your_cluster_prefix.root

# TiDB Cloud Password
DB_PASSWORD=your_secure_password_here

# (Optional) Alternative Single Connection String (DATABASE_URL)
# If provided, this takes precedence over individual DB_* variables:
# DATABASE_URL=mysql://your_user:your_password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/barangay_health_db
